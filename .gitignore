# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with go test -c
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out
coverage*
coverage_*

# Dependency directories
vendor/

# Go workspace file
go.work

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Project specific
mysql-to-sync
mysql-to-sync.exe
data/
logs/
*.log

# Frontend
web/node_modules/
web/dist/
web/.vite/

# Config
etc/application.toml
!etc/application.toml.example

# Temp files
*.tmp
*.bak

# Test data directories (test runtime artifacts, not tracked fixtures)
internal/task/application/service/test_task_service_*/
internal/task/application/service/test_task_storage_*/

# Local codebase-memory MCP index cache (do not commit)
.codebase-memory/
