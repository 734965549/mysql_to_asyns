# MySQL-to-Async 配置文件示例
# 复制此文件为 application.toml 并根据实际情况修改配置

[http]
  # HTTP服务Host
  host = "127.0.0.1"
  # HTTP服务端口
  port = 8081

[datasource]
  # 源数据库配置（默认值）
  # 如果创建任务时没有指定自定义源数据库，将使用此配置
  provider = "mysql"
  # host = "192.168.139.143"
  # port = 3306
  # database = "test"
  # username = "root"
  # password = "123456"
  debug = true
  # 跨机房或大 JSON/文本字段时建议 true，启用 MySQL 协议压缩降低传输量（略增 CPU）
  # compress = true

[target]
  # 目标数据库配置（默认值）
  # 如果创建任务时没有指定目标数据库，将使用此配置
  # host = "192.168.139.143"
  # port = 3306
  # database = "test_target"
  # username = "root"
  # password = "123456"
  # compress = true

# 全量同步吞吐与连接池（实例资源充足时可加大；需小于 MySQL max_connections，并留余量给其它客户端）
[sync]
  # 源/目标 sql.DB 最大连接数；0 或未写则默认 32
  # source_max_open_conns = 512
  # target_max_open_conns = 512
  # source_max_idle_conns = 256
  # target_max_idle_conns = 256
  # 连接最大存活秒数；<=0 或未写时程序默认 180，须小于源/目标库 wait_timeout，减轻 invalid connection
  # conn_max_lifetime_seconds = 120
  # intra_table_legacy_cap = 64
  # intra_table_hard_max = 512
  # api_default_worker_count = 32
  # api_default_batch_size = 2000

[storage]
  # 任务存储后端配置
  # 支持 "file" 或 "mysql"
  mode = "file"
  
  # 文件存储配置（mode = "file" 时使用）
  data_dir = "data"
  
  # MySQL存储配置（mode = "mysql" 时使用）
  # host = "127.0.0.1"
  # port = 3306
  # database = "mysql_to_async"
  # username = "root"
  # password = "123456"

[security]
  # 密码加密密钥（AES-256），用于加密存储到数据库/文件中的任务密码
  # 建议 32 字节（不足自动补齐，超过截断）；留空则不加密
  # 也可通过环境变量 MYSQL_TO_ASYNC_SECURITY_ENCRYPT_KEY 设置
  # encrypt_key = "your-32-byte-secret-key-here!!!!"

[redis]
  # Redis配置（可选）
  # 用于保存增量同步的Checkpoint位点
  # 如果不配置，则使用内存存储（服务重启后位点丢失）
  # host = "127.0.0.1"
  # port = 6379
  # password = ""
  # db = 0

[log]
  # 日志级别: debug, info, warn, error
  level = "debug"

[log.console]
  # 是否输出到控制台
  enable = true
  # 是否禁用彩色输出
  no_color = false

[log.file]
  # 是否输出到文件
  enable = true
  # 日志文件目录（默认为 logs/）
  # dir = "logs"

# ========== 性能优化相关配置（可选）==========
# 这些配置可以在创建任务时覆盖

[sync]
  # 默认批次大小（每次读取/写入的行数）
  # 较大的值可以提高吞吐量，但会占用更多内存
  # 建议值：1000 - 10000
  # batch_size = 1000
  
  # 默认并发Worker数量
  # 用于表级别同步时的并发表数
  # 以及单表内部的并发分片数
  # 建议值：2 - 8，根据CPU核心数和数据库性能调整
  # worker_count = 4
  
  # 单表分片大小（行数）
  # 大表会被分成多个分片并行处理
  # 较小的值会产生更多分片，提高并行度，但增加开销
  # 建议值：50000 - 200000
  # chunk_size = 100000

# ========== 功能开关 ==========

[features]
  # 是否启用只读模式（同步期间目标数据库设为只读）
  # enable_readonly = true
  
  # 是否启用索引优化（删除非主键索引，同步完成后再重建）
  # optimize_index = false

# ========== 全量起点位点说明（无需配置）==========
# 全量同步开始前会自动短暂执行一次 FLUSH TABLES WITH READ LOCK 取到 binlog 位点，
# 随后立即 UNLOCK TABLES（过程毫秒级），用于后续增量同步起点。该行为对所有任务
# 默认生效，无任何 TOML / JSON 开关需要配置。
#
# 历史版本曾提供 enable_consistent_snapshot 任务级字段（"严格全局快照 + 长事务
# 连接池"模式），现已下线。如果你的客户端代码仍在传该字段，请直接删除——服务端
# 会忽略，不会报错。
